    public static int getMinValue(int[] arr) {
        int minValue = arr[0];
        for (int i = 1; i < arr.length; i++) {
            if (arr[i] < minValue) {
                minValue = arr[i];
            }
        }
        return minValue;
    }

    public static int getMinIndex(int[] arr, int minValue) {
        for (int i = 0; i < arr.length; i++) {
            if (arr[i] == minValue) {
                return i;
            }
        }
        return -1;
    }

    public static int[] concatenateArrays(int[] arr, int minIndex) {
        int[] firstPart = Arrays.copyOfRange(arr, minIndex, arr.length);
        int[] secondPart = Arrays.copyOfRange(arr, 0, minIndex);
        int[] myArr = new int[arr.length];
        System.arraycopy(firstPart, 0, myArr, 0, firstPart.length);
        System.arraycopy(secondPart, 0, myArr, firstPart.length, secondPart.length);
        return myArr;
    }


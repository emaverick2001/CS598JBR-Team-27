    public static int primeFib(int n) {
        List<Integer> f = new ArrayList<>();
        f.add(0);
        f.add(1);
        while (true) {
            f.add(f.get(f.size() - 1) + f.get(f.size() - 2));
            if (isPrime(f.get(f.size() - 1))) {
                n -= 1;

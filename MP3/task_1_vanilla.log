    public static boolean moveOneBall(int[] arr) {
        if (arr.length == 0) {
            return true;
        }
        int[] sortedArray = arr.clone();
        Arrays.sort(sortedArray);
        int minValue = getMinValue(arr);
        int minIndex = getMinIndex(arr, minValue);
        int[] myArr = concatenateArrays(arr, minIndex);
        return areArraysEqual(myArr, sortedArray);
